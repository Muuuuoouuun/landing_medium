{
  "name": "classin-solo-20s",
  "private": true,
  "version": "0.1.0",
  "description": "ClassIn 20s cinematic kinetic-typography commercial for solo academy directors (1\uc778 \uc6d0\uc7a5)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ClassIn20s out/classin-20s.mp4",
    "still": "remotion still src/index.ts ClassIn20s out/still.png",
    "audio:setup": "python3 -m venv .venv-audio && .venv-audio/bin/pip install -r audio/requirements.txt",
    "audio:cues": "tsx scripts/export-cues.ts",
    "audio": "npm run audio:cues && .venv-audio/bin/python audio/build_audio.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "@remotion/layout-utils": "4.0.533",
    "@remotion/media-utils": "4.0.533",
    "@remotion/motion-blur": "4.0.533",
    "@remotion/noise": "4.0.533",
    "@remotion/paths": "4.0.533",
    "@remotion/shapes": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
